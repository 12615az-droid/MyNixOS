// Nix Aurora — colours are substituted from palette.nix by Home Manager.
input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
}
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}
layout {
    gaps 12
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    background-color "#@background@"
    focus-ring {
        width 3
        active-gradient from="#@blue@" to="#@mint@" angle=45
        inactive-color "#@border@"
    }
    border {
        width 1
        active-color "#@purple@"
        inactive-color "#@border@"
    }
    shadow {
        on
        softness 28
        spread 3
        offset x=0 y=6
        color "#00000055"
    }
    insert-hint { color "#@purple@66"; }
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"
workspace "main"
workspace "work"
workspace "chat"
workspace "games"
window-rule {
    geometry-corner-radius 12
    opacity 1.0
    clip-to-geometry true
}
window-rule {
    match app-id="^(pavucontrol|blueman-manager|nm-connection-editor)$"
    open-floating true
}
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id="^(discord|com.ayugram.desktop|io.github.ayugram.desktop)$"
    open-on-workspace "chat"
}
binds {
    Mod+Return hotkey-overlay-title="Терминал" { spawn "kitty"; }
    Mod+T { spawn "kitty"; }
    Mod+D hotkey-overlay-title="Приложения" { spawn "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+E hotkey-overlay-title="Файлы" { spawn "thunar"; }
    Mod+B { spawn "firefox"; }
    Mod+L hotkey-overlay-title="Блокировка" { spawn "swaylock" "-f"; }
    Mod+Shift+E hotkey-overlay-title="Питание и выход" { spawn "noctalia-shell" "ipc" "call" "sessionMenu" "toggle"; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Tab { focus-workspace-previous; }
    Mod+Q repeat=false { close-window; }
    Alt+F4 repeat=false { close-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Ctrl+Shift+Left { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+1 { focus-workspace "main"; }
    Mod+2 { focus-workspace "work"; }
    Mod+3 { focus-workspace "chat"; }
    Mod+4 { focus-workspace "games"; }
    Mod+Ctrl+1 { move-column-to-workspace "main"; }
    Mod+Ctrl+2 { move-column-to-workspace "work"; }
    Mod+Ctrl+3 { move-column-to-workspace "chat"; }
    Mod+Ctrl+4 { move-column-to-workspace "games"; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+C { center-column; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+X hotkey-overlay-title="Обои" { spawn "noctalia-shell" "ipc" "call" "wallpaper" "toggle"; }
    Mod+S hotkey-overlay-title="Центр управления" { spawn "noctalia-shell" "ipc" "call" "controlCenter" "toggle"; }
    Mod+Shift+S { screenshot; }
    Mod+N { spawn "noctalia-shell" "ipc" "call" "notifications" "toggleHistory"; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "+10%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "10%-"; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Ctrl+Alt+Delete { quit; }
}
